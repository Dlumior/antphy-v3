{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dlumior/antphy-v3/contracts/schemas/instance.schema.json",
  "title": "Instancia de ruteo",
  "description": "Datos de entrada del motor. Las matrices llegan ya calculadas (OSRM o geodésica); el motor no accede a la red.",
  "type": "object",
  "required": ["schema_version", "name", "depot", "nodes", "vehicles", "matrices"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1" },
    "name": { "type": "string", "minLength": 1 },
    "depot": { "type": "integer", "minimum": 0, "description": "Índice del almacén en nodes." },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "demand"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "demand": { "type": "number", "minimum": 0 },
          "urgency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0,
            "description": "Severidad u_i ya calculada a partir del escenario."
          }
        }
      }
    },
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "capacity"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "capacity": { "type": "number", "exclusiveMinimum": 0 },
          "count": { "type": "integer", "minimum": 1, "default": 1 },
          "max_duration_s": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "matrices": {
      "type": "object",
      "required": ["distance_m", "duration_s"],
      "additionalProperties": false,
      "properties": {
        "distance_m": { "$ref": "#/$defs/squareMatrix" },
        "duration_s": { "$ref": "#/$defs/squareMatrix" }
      }
    }
  },
  "$defs": {
    "squareMatrix": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "number", "minimum": 0 } }
    }
  }
}
